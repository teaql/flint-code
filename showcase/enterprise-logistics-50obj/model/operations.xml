<?xml version="1.0" encoding="UTF-8"?>
<root>
  <!-- 1. Moving Order -->
  <moving_order _name="Moving Order"
                _module="Operations" _module_key="operations"
                order_id="string()"
                customer="private_customer()"
                status="string()"
                total_weight="500.00"
                total_volume="10.00"
                estimated_cost="1500.00"
                actual_cost="1600.00"
                pickup_date="2023-10-01"
                delivery_date="2023-10-05"
                special_instructions="string()"
                create_time="createTime()"
                update_time="updateTime()">
    <_audit_mask_fields>
      <field name="customer" />
    </_audit_mask_fields>
  </moving_order>

  <!-- 2. Dispatch Plan -->
  <dispatch_plan _name="Dispatch Plan"
                 _module="Operations" _module_key="operations"
                 plan_id="string()"
                 moving_order="moving_order()"
                 vehicle="vehicle()"
                 driver="staff_member()"
                 status="string()"
                 scheduled_departure="2023-10-01T08:00:00"
                 scheduled_arrival="2023-10-01T18:00:00"
                 create_time="createTime()"
                 update_time="updateTime()" />

  <!-- 3. Transit Route -->
  <transit_route _name="Transit Route"
                 _module="Operations" _module_key="operations"
                 route_id="string()"
                 name="string()"
                 origin_warehouse="warehouse()"
                 destination_warehouse="warehouse()"
                 distance_km="150.00"
                 estimated_duration_hours="3.00"
                 status="string()"
                 create_time="createTime()" />

  <!-- 4. Time Slot -->
  <time_slot _name="Time Slot"
             _module="Operations" _module_key="operations"
             slot_id="string()"
             moving_order="moving_order()"
             start_time="2023-10-01T09:00:00"
             end_time="2023-10-01T10:00:00"
             status="string()"
             create_time="createTime()" />

  <!-- 5. Cargo Item -->
  <cargo_item _name="Cargo Item"
              _module="Operations" _module_key="operations"
              item_id="string()"
              moving_order="moving_order()"
              description="string()"
              category="string()"
              weight_kg="25.00"
              volume_m3="0.50"
              value="1000.00"
              fragile="true"
              create_time="createTime()" />

  <!-- 6. Pickup Address -->
  <pickup_address _name="Pickup Address"
                  _module="Operations" _module_key="operations"
                  address_id="string()"
                  moving_order="moving_order()"
                  address_line1="string()"
                  address_line2="string()"
                  city="string()"
                  state="string()"
                  zip_code="string()"
                  country="string()"
                  contact_name="string()"
                  contact_phone="string()"
                  create_time="createTime()" />
</root>