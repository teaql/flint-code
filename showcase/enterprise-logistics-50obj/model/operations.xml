<?xml version="1.0" encoding="UTF-8"?>
<root>
  <!-- 1. Moving Order -->
  <moving_order _name="Moving Order"
                _module="Operations" _module_key="operations"
                order_number="string()"
                status="order_status()"
                customer="private_customer()"
                pickup_address="pickup_address()"
                delivery_address="pickup_address()"
                total_weight="500.00"
                total_volume="10.50"
                estimated_cost="1500.00"
                actual_cost="1550.00"
                created_time="createTime()"
                updated_time="updateTime()">
    <_audit_mask_fields>
      <field name="customer_id" />
    </_audit_mask_fields>
  </moving_order>

  <!-- 2. Dispatch Plan -->
  <dispatch_plan _name="Dispatch Plan"
                 _module="Operations" _module_key="operations"
                 plan_number="string()"
                 status="plan_status()"
                 moving_order="moving_order()"
                 vehicle="vehicle()"
                 driver="staff_member()"
                 scheduled_departure="createTime()"
                 scheduled_arrival="createTime()"
                 created_time="createTime()"
                 updated_time="updateTime()" />

  <!-- 3. Transit Route -->
  <transit_route _name="Transit Route"
                 _module="Operations" _module_key="operations"
                 route_code="string()"
                 origin_city="string()"
                 destination_city="string()"
                 distance_km="1200.00"
                 estimated_duration_hours="14.00"
                 created_time="createTime()"
                 updated_time="updateTime()" />

  <!-- 4. Time Slot -->
  <time_slot _name="Time Slot"
             _module="Operations" _module_key="operations"
             slot_code="string()"
             start_time="createTime()"
             end_time="createTime()"
             capacity="10"
             available_spots="5"
             created_time="createTime()"
             updated_time="updateTime()" />

  <!-- 5. Cargo Item -->
  <cargo_item _name="Cargo Item"
              _module="Operations" _module_key="operations"
              item_code="string()"
              description="string()"
              weight_kg="25.00"
              volume_m3="0.50"
              fragile="true"
              moving_order="moving_order()"
              created_time="createTime()"
              updated_time="updateTime()" />

  <!-- 6. Pickup Address -->
  <pickup_address _name="Pickup Address"
                  _module="Operations" _module_key="operations"
                  address_line1="string()"
                  address_line2="string()"
                  city="string()"
                  state_province="string()"
                  postal_code="string()"
                  country="string()"
                  latitude="40.7128"
                  longitude="-74.0060"
                  created_time="createTime()"
                  updated_time="updateTime()" />
</root>