                    email="alice.johnson@example.com"
                    phone="+1122334455"
                    relationship="Spouse"
                    private_customer="private_customer()"
                    corporate_customer="corporate_customer()"
                    create_time="createTime()"
                    update_time="updateTime()"/>
                    
  <billing_info _name="BillingInfo"
                _module="CustomerManagement"
                _module_key="customer_management"
