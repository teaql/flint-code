<?xml version="1.0" encoding="UTF-8"?>
<root alias_model_name="products_services"
      chinese_name="产品与服务"
      english_name="Products and Services"
      name="products-services"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="products_services">
  
  <moving_service _name="MovingService"
                  _module="Products & Services"
                  _module_key="products_services"
                  name="Standard Moving"
                  description="Full-service residential move"
                  base_price="150.00"
                  create_time="createTime()"
                  update_time="updateTime()"/>
                  
  <cleaning_service _name="CleaningService"
                    _module="Products & Services"
                    _module_key="products_services"
                    name="Deep Cleaning"
                    description="Post-move deep cleaning"
                    hourly_rate="25.00"
                    create_time="createTime()"
                    update_time="updateTime()"/>
                    
  <box_rental _name="BoxRental"
              _module="Products & Services"
              _module_key="products_services"
              name="Moving Box Kit"
              description="Set of 10 medium moving boxes"
              daily_rate="2.00"
              deposit="50.00"
              create_time="createTime()"
              update_time="updateTime()"/>
              
  <additional_service _name="AdditionalService"
                      _module="Products & Services"
                      _module_key="products_services"
                      name="Furniture Disassembly"
                      description="Disassembly and reassembly of furniture"
                      flat_fee="75.00"
                      create_time="createTime()"
                      update_time="updateTime()"/>
                      
  <service_configuration _name="ServiceConfiguration"
                         _module="Products & Services"
                         _module_key="products_services"
                         name="Premium Package"
                         moving_service="moving_service()"
                         cleaning_service="cleaning_service()"
                         box_rental="box_rental()"
                         additional_service="additional_service()"
                         total_price="300.00"
                         create_time="createTime()"
                         update_time="updateTime()"/>
</root>