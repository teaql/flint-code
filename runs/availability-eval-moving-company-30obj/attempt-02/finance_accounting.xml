<?xml version="1.0" encoding="UTF-8"?>
<root alias_model_name="moving_company_management"
      chinese_name="搬家公司管理"
      english_name="Moving Company Management"
      name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">
  
  <payment _name="Payment"
             _module="Finance & Accounting"
             _module_key="finance_accounting"
             amount="0.00"
             payment_date="createTime()"
             payment_method="Credit Card"
             status="Pending"
             invoice="invoice()"
             create_time="createTime()"
             update_time="updateTime()"/>
             
  <invoice _name="Invoice"
             _module="Finance & Accounting"
             _module_key="finance_accounting"
             invoice_number="INV-0001"
             issue_date="createTime()"
             due_date="createTime()"
             total_amount="0.00"
             status="Draft"
             customer="customer()"
             create_time="createTime()"
             update_time="updateTime()"/>
             
  <expense _name="Expense"
             _module="Finance & Accounting"
             _module_key="finance_accounting"
             description="Office supplies"
             amount="0.00"
             expense_date="createTime()"
             category="Operational"
             vendor="vendor()"
             create_time="createTime()"
             update_time="updateTime()"/>
             
  <vat_record _name="VATRecord"
                  _module="Finance & Accounting"
                  _module_key="finance_accounting"
                  taxable_amount="0.00"
                  vat_rate="0.21"
                  vat_amount="0.00"
                  transaction_date="createTime()"
                  transaction_type="Sale"
                  related_document="invoice()"
                  create_time="createTime()"
                  update_time="updateTime()"/>
                  
  <financial_summary _name="FinancialSummary"
                         _module="Finance & Accounting"
                         _module_key="finance_accounting"
                         period_start="createTime()"
                         period_end="createTime()"
                         total_revenue="0.00"
                         total_expenses="0.00"
                         net_profit="0.00"
                         create_time="createTime()"
                         update_time="updateTime()"/>
</root>