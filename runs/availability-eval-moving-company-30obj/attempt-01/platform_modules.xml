<?xml version="1.0" encoding="UTF-8"?>
<root alias_model_name="moving_company_management"
      chinese_name="搬家公司管理"
      english_name="Moving Company Management"
      name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="doublechaintech"
      _module_key="root">
  
  <user _name="User"
            _module="Platform"
            _module_key="platform"
            username="john_doe"
            email="john@example.com"
            password_hash="hashed_password_123"
            create_time="createTime()"
            update_time="updateTime()"
            _audit_mask_fields="password_hash"/>
            
  <role _name="Role"
            _module="Platform"
            _module_key="platform"
            name="admin"
            description="System administrator"
            create_time="createTime()"
            update_time="updateTime()"/>
            
  <permission _name="Permission"
                  _module="Platform"
                  _module_key="platform"
                  name="manage_users"
                  description="Permission to manage user accounts"
                  create_time="createTime()"
                  update_time="updateTime()"/>
                  
  <activity_log _name="ActivityLog"
                    _module="Platform"
                    _module_key="platform"
                    action="login"
                    details="User logged in from IP 192.168.1.1"
                    user="user()"
                    create_time="createTime()"
                    update_time="updateTime()"/>
                    
  <notification _name="Notification"
                    _module="Platform"
                    _module_key="platform"
                    title="Payment Received"
                    message="Payment of $150.00 received for invoice INV-001"
                    type="email"
                    recipient="user()"
                    create_time="createTime()"
                    update_time="updateTime()"/>
                    
  <api_endpoint _name="ApiEndpoint"
                    _module="Platform"
                    _module_key="platform"
                    path="/api/v1/moves"
                    method="GET"
                    description="Retrieve list of moving events"
                    create_time="createTime()"
                    update_time="updateTime()"/>
</root>