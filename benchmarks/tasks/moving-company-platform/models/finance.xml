<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <invoice _name="Invoice"
             _module="finance_and_accounting"
             _module_key="invoices"
             invoice_number="INV00001"
             customer="customer()"
             move_order="move_order()"
             issue_date="2025-09-16"
             due_date="2025-10-16"
             subtotal="1200.00"
             vat_amount="264.00"
             total_amount="1464.00"
             status="invoice_status_type()"
             create_time="createTime()"
             update_time="updateTime()"/>

    <payment _name="Payment"
             _module="finance_and_accounting"
             _module_key="payments"
             payment_number="PAY00001"
             invoice="invoice()"
             customer="customer()"
             amount="1464.00"
             payment_method="payment_method_type()"
             payment_date="2025-09-20"
             reference_number="TXN-98765"
             status="payment_status_type()"
             create_time="createTime()"
             update_time="updateTime()"/>

    <expense _name="Expense"
             _module="finance_and_accounting"
             _module_key="expenses"
             expense_number="EXP00001"
             expense_category="expense_category()"
             description="Fuel for truck fleet"
             amount="450.00"
             expense_date="2025-09-15"
             recorded_by="employee()"
             status="expense_status_type()"
             create_time="createTime()"
             update_time="updateTime()"/>

    <vat_record _name="VAT Record"
                _module="finance_and_accounting"
                _module_key="vat"
                invoice="invoice()"
                vat_rate="22.00"
                vat_amount="264.00"
                tax_period="2025-Q3"
                create_time="createTime()"
                update_time="updateTime()"/>

    <financial_summary _name="Financial Summary"
                       _module="finance_and_accounting"
                       _module_key="financial_summaries"
                       summary_period="2025-09"
                       total_revenue="45000.00"
                       total_expenses="18000.00"
                       net_profit="27000.00"
                       outstanding_receivables="12000.00"
                       create_time="createTime()"
                       update_time="updateTime()"/>

    <invoice_status_type _name="Invoice Status Type"
                         _module="finance_and_accounting"
                         _module_key="basic_data"
                         id="id()"
                         name="string()"
                         code="string()"
                         _constant="true"
                         _identifier="code">
        <_value id="1" name="Draft" code="DRAFT"/>
        <_value id="2" name="Sent" code="SENT"/>
        <_value id="3" name="Paid" code="PAID"/>
        <_value id="4" name="Overdue" code="OVERDUE"/>
        <_value id="5" name="Cancelled" code="CANCELLED"/>
    </invoice_status_type>

    <payment_status_type _name="Payment Status Type"
                         _module="finance_and_accounting"
                         _module_key="basic_data"
                         id="id()"
                         name="string()"
                         code="string()"
                         _constant="true"
                         _identifier="code">
        <_value id="1" name="Pending" code="PENDING"/>
        <_value id="2" name="Completed" code="COMPLETED"/>
        <_value id="3" name="Failed" code="FAILED"/>
        <_value id="4" name="Refunded" code="REFUNDED"/>
    </payment_status_type>

    <expense_category _name="Expense Category"
                      _module="finance_and_accounting"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="Fuel" code="FUEL"/>
        <_value id="2" name="Maintenance" code="MAINTENANCE"/>
        <_value id="3" name="Insurance" code="INSURANCE"/>
        <_value id="4" name="Office Supplies" code="OFFICE_SUPPLIES"/>
        <_value id="5" name="Marketing" code="MARKETING"/>
    </expense_category>

    <expense_status_type _name="Expense Status Type"
                         _module="finance_and_accounting"
                         _module_key="basic_data"
                         id="id()"
                         name="string()"
                         code="string()"
                         _constant="true"
                         _identifier="code">
        <_value id="1" name="Submitted" code="SUBMITTED"/>
        <_value id="2" name="Approved" code="APPROVED"/>
        <_value id="3" name="Reimbursed" code="REIMBURSED"/>
        <_value id="4" name="Rejected" code="REJECTED"/>
    </expense_status_type>

</root>
