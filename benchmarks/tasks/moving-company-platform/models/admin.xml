<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">
  
  <contract_status _name="Contract Status"
                   _module="Admin"
                   _module_key="admin"
                   id="id()"
                   name="string()"
                   code="string()"
                   color="string()"
                   display_order="number()"
                   _constant="true"
                   _identifier="code">
    <_value id="1001" name="Draft" code="DRAFT"
            color="#F59E0B" display_order="1"/>
    <_value id="1002" name="Active" code="ACTIVE"
            color="#16A34A" display_order="2"/>
    <_value id="1003" name="Expired" code="EXPIRED"
            color="#6B7280" display_order="3"/>
    <_value id="1004" name="Terminated" code="TERMINATED"
            color="#EF4444" display_order="4"/>
  </contract_status>
  
  <contract _name="Contract"
            _module="Admin"
            _module_key="admin"
            customer="customer()"
            contract_number="CTR-2025-001"
            start_date="2025-01-01"
            end_date="2025-12-31"
            status="contract_status()"
            terms="Standard moving services agreement"
            create_time="createTime()"
            update_time="updateTime()"/>
  
  <insurance_policy _name="Insurance Policy"
                    _module="Admin"
                    _module_key="admin"
                    policy_number="INS-2025-001"
                    provider="SafeMove Insurance"
                    coverage_type="liability"
                    coverage_amount="1000000.00"
                    premium_amount="5000.00"
                    start_date="2025-01-01"
                    end_date="2025-12-31"
                    status="active"
                    create_time="createTime()"
                    update_time="updateTime()"/>
  
  <document_type _name="Document Type"
                 _module="Admin"
                 _module_key="admin"
                 id="id()"
                 name="string()"
                 code="string()"
                 color="string()"
                 display_order="number()"
                 _constant="true"
                 _identifier="code">
    <_value id="1001" name="Contract" code="CONTRACT"
            color="#2563EB" display_order="1"/>
    <_value id="1002" name="Invoice" code="INVOICE"
            color="#16A34A" display_order="2"/>
    <_value id="1003" name="Receipt" code="RECEIPT"
            color="#F59E0B" display_order="3"/>
    <_value id="1004" name="Insurance" code="INSURANCE"
            color="#8B5CF6" display_order="4"/>
  </document_type>
  
  <document _name="Document"
            _module="Admin"
            _module_key="admin"
            document_type="document_type()"
            title="Moving Contract"
            file_path="/documents/contract-2025-001.pdf"
            file_size="1024"
            upload_date="2025-01-15"
            create_time="createTime()"
            update_time="updateTime()"/>
  
  <audit_log _name="Audit Log"
             _module="Admin"
             _module_key="admin"
             user="user()"
             action="update"
             entity_type="customer"
             entity_id="1"
             old_value="Jane Smith"
             new_value="Jane Doe"
             timestamp="2025-06-01T10:30:00"
             ip_address="192.168.1.100"
             create_time="createTime()"
             update_time="updateTime()"/>
</root>
