<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <employee _name="Employee"
              _module="employees_and_payroll"
              _module_key="employee_management"
              employee_number="EMP00001"
              name="John Smith"
              gender="gender_type()"
              birth_date="1990-05-15"
              mobile_phone="+12125551234"
              email="john.smith@movers.com"
              job_title="Senior Mover"
              hiring_date="2020-03-01"
              status="employee_status_type()"
              create_time="createTime()"
              update_time="updateTime()"/>

    <job_assignment _name="Job Assignment"
                    _module="employees_and_payroll"
                    _module_key="job_assignments"
                    employee="employee()"
                    move_order="move_order()"
                    role_on_job="job_role_type()"
                    assigned_date="2025-09-10"
                    status="assignment_status_type()"
                    create_time="createTime()"
                    update_time="updateTime()"/>

    <worked_hours _name="Worked Hours"
                  _module="employees_and_payroll"
                  _module_key="worked_hours"
                  employee="employee()"
                  move_order="move_order()"
                  work_date="2025-09-15"
                  hours_worked="8.5"
                  overtime_hours="1.5"
                  hourly_rate="25.00"
                  create_time="createTime()"
                  update_time="updateTime()"/>

    <payroll_calculation _name="Payroll Calculation"
                         _module="employees_and_payroll"
                         _module_key="payroll"
                         employee="employee()"
                         pay_period_start="2025-09-01"
                         pay_period_end="2025-09-15"
                         base_pay="2000.00"
                         overtime_pay="375.00"
                         deductions="150.00"
                         net_pay="2225.00"
                         status="payroll_status_type()"
                         create_time="createTime()"
                         update_time="updateTime()"/>

    <bonus _name="Bonus"
           _module="employees_and_payroll"
           _module_key="bonuses"
           employee="employee()"
           bonus_type="bonus_type()"
           amount="500.00"
           reason="Excellent customer feedback"
           awarded_date="2025-09-20"
           create_time="createTime()"
           update_time="updateTime()"/>

    <leave_record _name="Leave Record"
                  _module="employees_and_payroll"
                  _module_key="leave_tracking"
                  employee="employee()"
                  leave_type="leave_type()"
                  start_date="2025-10-01"
                  end_date="2025-10-05"
                  days_count="5"
                  reason="Family vacation"
                  status="leave_status_type()"
                  create_time="createTime()"
                  update_time="updateTime()"/>

    <gender_type _name="Gender Type"
                 _module="employees_and_payroll"
                 _module_key="basic_data"
                 id="id()"
                 name="string()"
                 code="string()"
                 _constant="true"
                 _identifier="code">
        <_value id="1" name="Male" code="MALE"/>
        <_value id="2" name="Female" code="FEMALE"/>
        <_value id="3" name="Other" code="OTHER"/>
    </gender_type>

    <employee_status_type _name="Employee Status Type"
                          _module="employees_and_payroll"
                          _module_key="basic_data"
                          id="id()"
                          name="string()"
                          code="string()"
                          _constant="true"
                          _identifier="code">
        <_value id="1" name="Active" code="ACTIVE"/>
        <_value id="2" name="On Leave" code="ON_LEAVE"/>
        <_value id="3" name="Terminated" code="TERMINATED"/>
    </employee_status_type>

    <job_role_type _name="Job Role Type"
                   _module="employees_and_payroll"
                   _module_key="basic_data"
                   id="id()"
                   name="string()"
                   code="string()"
                   _constant="true"
                   _identifier="code">
        <_value id="1" name="Lead Mover" code="LEAD_MOVER"/>
        <_value id="2" name="Mover" code="MOVER"/>
        <_value id="3" name="Driver" code="DRIVER"/>
        <_value id="4" name="Packer" code="PACKER"/>
    </job_role_type>

    <assignment_status_type _name="Assignment Status Type"
                            _module="employees_and_payroll"
                            _module_key="basic_data"
                            id="id()"
                            name="string()"
                            code="string()"
                            _constant="true"
                            _identifier="code">
        <_value id="1" name="Assigned" code="ASSIGNED"/>
        <_value id="2" name="In Progress" code="IN_PROGRESS"/>
        <_value id="3" name="Completed" code="COMPLETED"/>
        <_value id="4" name="Cancelled" code="CANCELLED"/>
    </assignment_status_type>

    <payroll_status_type _name="Payroll Status Type"
                         _module="employees_and_payroll"
                         _module_key="basic_data"
                         id="id()"
                         name="string()"
                         code="string()"
                         _constant="true"
                         _identifier="code">
        <_value id="1" name="Draft" code="DRAFT"/>
        <_value id="2" name="Approved" code="APPROVED"/>
        <_value id="3" name="Paid" code="PAID"/>
    </payroll_status_type>

    <bonus_type _name="Bonus Type"
                _module="employees_and_payroll"
                _module_key="basic_data"
                id="id()"
                name="string()"
                code="string()"
                _constant="true"
                _identifier="code">
        <_value id="1" name="Performance" code="PERFORMANCE"/>
        <_value id="2" name="Referral" code="REFERRAL"/>
        <_value id="3" name="Holiday" code="HOLIDAY"/>
    </bonus_type>

    <leave_type _name="Leave Type"
                _module="employees_and_payroll"
                _module_key="basic_data"
                id="id()"
                name="string()"
                code="string()"
                _constant="true"
                _identifier="code">
        <_value id="1" name="Vacation" code="VACATION"/>
        <_value id="2" name="Sick" code="SICK"/>
        <_value id="3" name="Personal" code="PERSONAL"/>
        <_value id="4" name="Unpaid" code="UNPAID"/>
    </leave_type>

    <leave_status_type _name="Leave Status Type"
                       _module="employees_and_payroll"
                       _module_key="basic_data"
                       id="id()"
                       name="string()"
                       code="string()"
                       _constant="true"
                       _identifier="code">
        <_value id="1" name="Pending" code="PENDING"/>
        <_value id="2" name="Approved" code="APPROVED"/>
        <_value id="3" name="Rejected" code="REJECTED"/>
    </leave_status_type>

</root>
