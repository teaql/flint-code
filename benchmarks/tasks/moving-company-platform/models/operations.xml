<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <address _name="Address"
             _module="operations_and_logistics"
             _module_key="addresses"
             line1="123 Main Street"
             line2="Apt 4B"
             city="New York"
             region="NY"
             postal_code="10001"
             country="USA"
             latitude="40.7128"
             longitude="-74.0060"
             create_time="createTime()"
             update_time="updateTime()"/>

    <route _name="Route"
           _module="operations_and_logistics"
           _module_key="routes"
           route_name="NYC to Boston Express"
           start_city="New York"
           end_city="Boston"
           distance_km="350"
           estimated_duration_hours="4.5"
           create_time="createTime()"
           update_time="updateTime()"/>

    <time_slot _name="Time Slot"
               _module="operations_and_logistics"
               _module_key="time_slots"
               slot_name="Morning Window"
               start_time="08:00"
               end_time="12:00"
               is_peak_hour="true"
               create_time="createTime()"
               update_time="updateTime()"/>

    <move_order _name="Move Order"
                _module="operations_and_logistics"
                _module_key="moves"
                order_number="MOV00001"
                customer="customer()"
                pickup_address="address()"
                delivery_address="address()"
                route="route()"
                time_slot="time_slot()"
                scheduled_date="2025-09-15"
                status="move_status_type()"
                total_weight_kg="2500.00"
                special_instructions="Handle piano with care"
                create_time="createTime()"
                update_time="updateTime()"/>

    <move_item _name="Move Item"
               _module="operations_and_logistics"
               _module_key="moves"
               move_order="move_order()"
               product="product()"
               quantity="5"
               unit_price="150.00"
               extended_price="750.00"
               create_time="createTime()"
               update_time="updateTime()"/>

    <fulfillment_event _name="Fulfillment Event"
                       _module="operations_and_logistics"
                       _module_key="fulfillment_events"
                       move_order="move_order()"
                       event_type="event_type()"
                       event_time="updateTime()"
                       location_address="address()"
                       notes="Truck loaded and departed"
                       performed_by="employee()"
                       create_time="createTime()"/>

    <move_status_type _name="Move Status Type"
                      _module="operations_and_logistics"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="Pending" code="PENDING"/>
        <_value id="2" name="Confirmed" code="CONFIRMED"/>
        <_value id="3" name="In Transit" code="IN_TRANSIT"/>
        <_value id="4" name="Delivered" code="DELIVERED"/>
        <_value id="5" name="Cancelled" code="CANCELLED"/>
    </move_status_type>

    <event_type _name="Event Type"
                _module="operations_and_logistics"
                _module_key="basic_data"
                id="id()"
                name="string()"
                code="string()"
                _constant="true"
                _identifier="code">
        <_value id="1" name="Pickup Scheduled" code="PICKUP_SCHEDULED"/>
        <_value id="2" name="Loading Started" code="LOADING_STARTED"/>
        <_value id="3" name="In Transit" code="IN_TRANSIT"/>
        <_value id="4" name="Unloading Started" code="UNLOADING_STARTED"/>
        <_value id="5" name="Delivery Completed" code="DELIVERY_COMPLETED"/>
    </event_type>

</root>
