<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <campaign _name="Campaign"
              _module="marketing_and_sales"
              _module_key="campaigns"
              campaign_code="CAMP2025FALL"
              name="Fall Moving Season Promo"
              description="20% off all moves in September"
              campaign_type="campaign_type()"
              start_date="2025-09-01"
              end_date="2025-09-30"
              budget="10000.00"
              status="campaign_status_type()"
              create_time="createTime()"
              update_time="updateTime()"/>

    <discount_code _name="Discount Code"
                   _module="marketing_and_sales"
                   _module_key="discount_codes"
                   code="FALL2025"
                   campaign="campaign()"
                   discount_type="discount_type()"
                   discount_value="20.00"
                   max_uses="500"
                   current_uses="42"
                   valid_from="2025-09-01"
                   valid_until="2025-09-30"
                   is_active="true"
                   create_time="createTime()"
                   update_time="updateTime()"/>

    <lead _name="Lead"
          _module="marketing_and_sales"
          _module_key="lead_tracking"
          lead_number="LEAD00001"
          source="lead_source_type()"
          contact_name="Robert Johnson"
          email="robert@example.com"
          phone="+12125557777"
          campaign="campaign()"
          status="lead_status_type()"
          estimated_value="2500.00"
          create_time="createTime()"
          update_time="updateTime()"/>

    <conversion_metric _name="Conversion Metric"
                       _module="marketing_and_sales"
                       _module_key="conversion_metrics"
                       campaign="campaign()"
                       metric_date="2025-09-15"
                       impressions="15000"
                       clicks="1200"
                       leads_generated="85"
                       conversions="12"
                       revenue_generated="9600.00"
                       create_time="createTime()"
                       update_time="updateTime()"/>

    <campaign_type _name="Campaign Type"
                   _module="marketing_and_sales"
                   _module_key="basic_data"
                   id="id()"
                   name="string()"
                   code="string()"
                   _constant="true"
                   _identifier="code">
        <_value id="1" name="Email" code="EMAIL"/>
        <_value id="2" name="Social Media" code="SOCIAL_MEDIA"/>
        <_value id="3" name="Referral" code="REFERRAL"/>
        <_value id="4" name="Print" code="PRINT"/>
    </campaign_type>

    <campaign_status_type _name="Campaign Status Type"
                          _module="marketing_and_sales"
                          _module_key="basic_data"
                          id="id()"
                          name="string()"
                          code="string()"
                          _constant="true"
                          _identifier="code">
        <_value id="1" name="Draft" code="DRAFT"/>
        <_value id="2" name="Active" code="ACTIVE"/>
        <_value id="3" name="Paused" code="PAUSED"/>
        <_value id="4" name="Completed" code="COMPLETED"/>
    </campaign_status_type>

    <discount_type _name="Discount Type"
                   _module="marketing_and_sales"
                   _module_key="basic_data"
                   id="id()"
                   name="string()"
                   code="string()"
                   _constant="true"
                   _identifier="code">
        <_value id="1" name="Percentage" code="PERCENTAGE"/>
        <_value id="2" name="Fixed Amount" code="FIXED_AMOUNT"/>
    </discount_type>

    <lead_source_type _name="Lead Source Type"
                      _module="marketing_and_sales"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="Website" code="WEBSITE"/>
        <_value id="2" name="Referral" code="REFERRAL"/>
        <_value id="3" name="Phone" code="PHONE"/>
        <_value id="4" name="Walk In" code="WALK_IN"/>
    </lead_source_type>

    <lead_status_type _name="Lead Status Type"
                      _module="marketing_and_sales"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="New" code="NEW"/>
        <_value id="2" name="Contacted" code="CONTACTED"/>
        <_value id="3" name="Qualified" code="QUALIFIED"/>
        <_value id="4" name="Converted" code="CONVERTED"/>
        <_value id="5" name="Lost" code="LOST"/>
    </lead_status_type>

</root>
