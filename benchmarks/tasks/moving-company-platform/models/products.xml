<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <product _name="Product"
             _module="products_and_services"
             _module_key="products"
             product_code="PROD001"
             name="Standard Moving Service"
             description="Full-service residential move with 3 movers"
             product_category="product_category()"
             base_price="800.00"
             is_active="true"
             create_time="createTime()"
             update_time="updateTime()"/>

    <service_configuration _name="Service Configuration"
                           _module="products_and_services"
                           _module_key="service_config"
                           product="product()"
                           config_name="Weekend Surcharge"
                           config_value="1.25"
                           config_type="config_value_type()"
                           create_time="createTime()"
                           update_time="updateTime()"/>

    <pricing_rule _name="Pricing Rule"
                  _module="products_and_services"
                  _module_key="pricing"
                  product="product()"
                  rule_name="Heavy Item Surcharge"
                  condition_description="Items over 100kg"
                  surcharge_amount="150.00"
                  is_active="true"
                  create_time="createTime()"
                  update_time="updateTime()"/>

    <product_category _name="Product Category"
                      _module="products_and_services"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="Moving" code="MOVING"/>
        <_value id="2" name="Cleaning" code="CLEANING"/>
        <_value id="3" name="Box Rental" code="BOX_RENTAL"/>
        <_value id="4" name="Additional Service" code="ADDITIONAL_SERVICE"/>
    </product_category>

    <config_value_type _name="Config Value Type"
                       _module="products_and_services"
                       _module_key="basic_data"
                       id="id()"
                       name="string()"
                       code="string()"
                       _constant="true"
                       _identifier="code">
        <_value id="1" name="Multiplier" code="MULTIPLIER"/>
        <_value id="2" name="Flat Fee" code="FLAT_FEE"/>
        <_value id="3" name="Percentage" code="PERCENTAGE"/>
    </config_value_type>

</root>
