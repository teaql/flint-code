<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

    <vehicle _name="Vehicle"
             _module="asset_management"
             _module_key="vehicles"
             vehicle_number="VEH001"
             make="Ford"
             model="Transit"
             year="2023"
             license_plate="ABC-1234"
             capacity_kg="3500"
             vehicle_type="vehicle_type()"
             status="vehicle_status_type()"
             last_service_date="2025-08-01"
             create_time="createTime()"
             update_time="updateTime()"/>

    <equipment _name="Equipment"
               _module="asset_management"
               _module_key="equipment"
               equipment_code="EQP001"
               name="Heavy Duty Dolly"
               equipment_type="equipment_type()"
               purchase_date="2024-01-15"
               condition="equipment_condition_type()"
               assigned_vehicle="vehicle()"
               create_time="createTime()"
               update_time="updateTime()"/>

    <consumable _name="Consumable"
                _module="asset_management"
                _module_key="consumables"
                consumable_code="CON001"
                name="Moving Blankets"
                quantity_in_stock="150"
                unit_cost="12.50"
                reorder_level="30"
                supplier_name="PackRight Supplies"
                create_time="createTime()"
                update_time="updateTime()"/>

    <maintenance_schedule _name="Maintenance Schedule"
                          _module="asset_management"
                          _module_key="maintenance"
                          vehicle="vehicle()"
                          maintenance_type="maintenance_type()"
                          scheduled_date="2025-10-01"
                          description="Oil change and tire rotation"
                          estimated_cost="350.00"
                          status="maintenance_status_type()"
                          create_time="createTime()"
                          update_time="updateTime()"/>

    <vehicle_type _name="Vehicle Type"
                  _module="asset_management"
                  _module_key="basic_data"
                  id="id()"
                  name="string()"
                  code="string()"
                  _constant="true"
                  _identifier="code">
        <_value id="1" name="Box Truck" code="BOX_TRUCK"/>
        <_value id="2" name="Flatbed" code="FLATBED"/>
        <_value id="3" name="Van" code="VAN"/>
        <_value id="4" name="Semi Trailer" code="SEMI_TRAILER"/>
    </vehicle_type>

    <vehicle_status_type _name="Vehicle Status Type"
                         _module="asset_management"
                         _module_key="basic_data"
                         id="id()"
                         name="string()"
                         code="string()"
                         _constant="true"
                         _identifier="code">
        <_value id="1" name="Available" code="AVAILABLE"/>
        <_value id="2" name="In Use" code="IN_USE"/>
        <_value id="3" name="In Maintenance" code="IN_MAINTENANCE"/>
        <_value id="4" name="Retired" code="RETIRED"/>
    </vehicle_status_type>

    <equipment_type _name="Equipment Type"
                    _module="asset_management"
                    _module_key="basic_data"
                    id="id()"
                    name="string()"
                    code="string()"
                    _constant="true"
                    _identifier="code">
        <_value id="1" name="Dolly" code="DOLLY"/>
        <_value id="2" name="Furniture Pad" code="FURNITURE_PAD"/>
        <_value id="3" name="Strap" code="STRAP"/>
        <_value id="4" name="Tool Kit" code="TOOL_KIT"/>
    </equipment_type>

    <equipment_condition_type _name="Equipment Condition Type"
                              _module="asset_management"
                              _module_key="basic_data"
                              id="id()"
                              name="string()"
                              code="string()"
                              _constant="true"
                              _identifier="code">
        <_value id="1" name="New" code="NEW"/>
        <_value id="2" name="Good" code="GOOD"/>
        <_value id="3" name="Fair" code="FAIR"/>
        <_value id="4" name="Poor" code="POOR"/>
    </equipment_condition_type>

    <maintenance_type _name="Maintenance Type"
                      _module="asset_management"
                      _module_key="basic_data"
                      id="id()"
                      name="string()"
                      code="string()"
                      _constant="true"
                      _identifier="code">
        <_value id="1" name="Routine" code="ROUTINE"/>
        <_value id="2" name="Repair" code="REPAIR"/>
        <_value id="3" name="Inspection" code="INSPECTION"/>
    </maintenance_type>

    <maintenance_status_type _name="Maintenance Status Type"
                             _module="asset_management"
                             _module_key="basic_data"
                             id="id()"
                             name="string()"
                             code="string()"
                             _constant="true"
                             _identifier="code">
        <_value id="1" name="Scheduled" code="SCHEDULED"/>
        <_value id="2" name="In Progress" code="IN_PROGRESS"/>
        <_value id="3" name="Completed" code="COMPLETED"/>
        <_value id="4" name="Overdue" code="OVERDUE"/>
    </maintenance_status_type>

</root>
